# Kopieren nach ".env" und anpassen.

# Öffentliche Adresse der Seite (mit https://, ohne / am Ende)
PUBLIC_ORIGIN=https://karteikarten.example.de

# Anzahl vorgeschalteter Proxys (Caddy = 1)
TRUST_PROXY=1

# Wie lange eine Anmeldung gültig bleibt
SESSION_HOURS_STAFF=12
SESSION_DAYS_CHILD=30

# Nur ändern, wenn die Seite ausnahmsweise OHNE HTTPS läuft (nicht empfohlen!)
# COOKIE_SECURE=false
